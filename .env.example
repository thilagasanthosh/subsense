# Copy to .env (git-ignored) to override defaults for docker compose.
DB_PASSWORD=subsense
SUBSENSE_REPORTING_CURRENCY=GBP
# Use the WireMock stub for repeatable rates (with --profile e2e):
# SUBSENSE_FX_BASE_URL=http://fx-stub:8080

# Push reminders via ntfy (https://ntfy.sh). Generate a topic with: openssl rand -hex 16
# SUBSENSE_NTFY_TOPIC=your-private-topic
# SUBSENSE_NTFY_TOKEN=            # optional, for protected topics
# SUBSENSE_NTFY_SERVER=https://ntfy.sh   # override for self-hosted ntfy
